{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shm.local/skills/compare/0.1.0",
  "title": "compare skill contract",
  "type": "object",
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "a",
        "b",
        "metric"
      ],
      "properties": {
        "dataset": {
          "const": "L1"
        },
        "a": {
          "type": "string",
          "pattern": "^(C[1-4]|L1-[0-9]{2})$"
        },
        "b": {
          "type": "string",
          "pattern": "^(C[1-4]|L1-[0-9]{2})$"
        },
        "metric": {
          "enum": [
            "t85",
            "t50"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "version",
        "status",
        "data",
        "warnings",
        "evidence",
        "report",
        "computation"
      ],
      "properties": {
        "skill": {
          "const": "compare"
        },
        "version": {
          "const": "0.1.0"
        },
        "status": {
          "enum": [
            "ok",
            "unsupported",
            "not_found",
            "error"
          ]
        },
        "data": {
          "type": "object",
          "required": [
            "a",
            "b",
            "metric",
            "comparison_type",
            "delta",
            "unit",
            "direction",
            "comparable"
          ],
          "properties": {
            "dataset": {
              "const": "L1"
            },
            "a": {
              "type": "string"
            },
            "b": {
              "type": "string"
            },
            "metric": {
              "enum": [
                "t85",
                "t50"
              ]
            },
            "comparison_type": {
              "enum": [
                "campaign_vs_campaign",
                "specimen_vs_campaign"
              ]
            },
            "delta": {
              "type": "number"
            },
            "unit": {
              "const": "percentage points"
            },
            "direction": {
              "type": "string"
            },
            "comparable": {
              "type": "boolean"
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "report": {
          "type": "string"
        },
        "computation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "formula",
            "inputs"
          ],
          "properties": {
            "kind": {
              "enum": [
                "read",
                "derived",
                "validated",
                "computed"
              ]
            },
            "formula": {
              "type": [
                "string",
                "null"
              ]
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}