{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shm.local/skills/check/0.1.0",
  "title": "check skill contract",
  "type": "object",
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "gid"
      ],
      "properties": {
        "dataset": {
          "enum": [
            "L1",
            "L2",
            "PHM2019"
          ]
        },
        "gid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "version",
        "status",
        "data",
        "warnings",
        "evidence",
        "report",
        "computation"
      ],
      "properties": {
        "skill": {
          "const": "check"
        },
        "version": {
          "const": "0.1.0"
        },
        "status": {
          "enum": [
            "ok",
            "insufficient",
            "not_found",
            "error"
          ]
        },
        "data": {
          "type": "object",
          "required": [
            "dataset",
            "gid",
            "exists",
            "modalities",
            "capabilities"
          ],
          "properties": {
            "dataset": {
              "type": "string"
            },
            "gid": {
              "type": "string"
            },
            "exists": {
              "type": "boolean"
            },
            "campaign": {
              "type": [
                "string",
                "null"
              ]
            },
            "fatigue_end": {
              "type": [
                "integer",
                "null"
              ]
            },
            "pzt_coverage_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "modalities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "available",
                  "note"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "n": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "t85_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "available",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "report": {
          "type": "string"
        },
        "computation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "formula",
            "inputs"
          ],
          "properties": {
            "kind": {
              "enum": [
                "read",
                "derived",
                "validated",
                "computed"
              ]
            },
            "formula": {
              "type": [
                "string",
                "null"
              ]
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}