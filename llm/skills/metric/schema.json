{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shm.local/skills/metric/0.1.0",
  "title": "metric skill contract",
  "type": "object",
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "gid"],
      "properties": {
        "dataset": { "const": "L1" },
        "gid": { "type": "string", "pattern": "^L1-[0-9]{2}$" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "version", "status", "data", "warnings", "evidence", "computation", "report"],
      "properties": {
        "skill": { "const": "metric" },
        "version": { "const": "0.1.0" },
        "status": { "enum": ["ok", "unsupported", "not_found", "error"] },
        "data": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "computation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "formula", "inputs"],
          "properties": {
            "kind": { "const": "computed" },
            "formula": { "type": ["string", "null"] },
            "inputs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "report": { "type": "string" }
      }
    }
  }
}
